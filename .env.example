# Copy this file to `.env` and set production values.
# Local development works without `.env` using test defaults in settings.py.

# --- Django ---
# Production settings. Without this the app runs with development defaults.
# DJANGO_SETTINGS_MODULE=marvin.prod_settings

# Required in production; marvin.prod_settings refuses to start without it,
# or with this placeholder. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Off by default for a public host. Turn on only for local development.
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Only needed if the site is served over plain http or on a non standard port.
# Otherwise https:// of each ALLOWED_HOSTS entry is trusted automatically.
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Database (optional, defaults to SQLite) ---
# For PostgreSQL, install the driver with `uv sync --extra postgres` (requirements.txt
# already includes it) and set the variables below. DATABASE_URL is not read; on
# Railway fill these from the Postgres service's PGDATABASE, PGUSER, PGPASSWORD,
# PGHOST and PGPORT reference variables.
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=marvin
# DATABASE_USER=marvin
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# Seconds to keep a connection open. 0 closes it after every request.
# DATABASE_CONN_MAX_AGE=60

# --- Branding ---
# What a fork changes to make this its own. All optional.
# BRAND_APP_NAME=Marvin
# BRAND_ORG_NAME=Geeko Foundation
# BRAND_TAGLINE=Travel Support Program
# The line under the name on the sign in page. Set it empty to drop it.
# BRAND_STRAPLINE=The Paranoid Android
# Link to the travel support policy people agree to, shown in the menu.
# BRAND_POLICY_URL=https://geekos.org/travel-policy/
# A theme built into the stylesheet, see css_build/app.css
# BRAND_THEME_LIGHT=i-layer-light
# BRAND_THEME_DARK=i-layer-dark

# --- Web Push (django-webpush) ---
# Generate a key pair once per deployment:
#   .venv/bin/vapid --gen && .venv/bin/vapid --applicationServerKey
# VAPID_PUBLIC_KEY is the printed Application Server Key. VAPID_PRIVATE_KEY is the
# contents of private_key.pem, on one line with \n for each line break.
WEBPUSH_APP_BASE_URL=https://yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# --- Uploaded documents ---
# Where receipts, invoices and signed forms are stored. A host that replaces
# its disk on each deploy, such as Railway, loses them unless this points at
# a mounted volume, for example a Railway volume mounted at /data:
# MEDIA_ROOT=/data/uploads

# --- Wise API ---
# false runs the app without Wise: no bank step at sign-up, payments recorded by hand.
# USE_WISE=true
# Always set this. settings.py falls back to a published sandbox token.
WISE_API_TOKEN=
WISE_API_PROFILE_ID=
WISE_API_SANDBOX=false
WISE_SOURCE_CURRENCY=EUR
# Wise's webhook signing key for this environment, from their docs. Needed
# only if you subscribe to transfer state changes. Newlines may be written \n.
# WISE_WEBHOOK_PUBLIC_KEY=
# Wise does not let personal-token users fund payments through the API, so
# Marvin creates them and finance approves them in Wise's website or app.

# --- Currencies ---
# Currencies the committee approves in (comma separated).
PAYOUT_CURRENCIES=EUR,USD,GBP
# Optional: today's rate from https://www.exchangerate-api.com (free plan is fine).
# Without it, the European Central Bank's free reference rates are used.
EXCHANGE_RATE_API_KEY=

# --- Email ---
# Mail is sent over SMTP with STARTTLS on port 587. Without EMAIL_HOST it goes
# to localhost, and is dropped if no mail server runs there.
EMAIL_HOST=smtp.yourprovider.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=marvin@yourdomain.com

# Base URL used for links inside notification emails.
SITE_BASE_URL=https://yourdomain.com
