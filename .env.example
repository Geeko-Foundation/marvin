# Copy this file to `.env` and set production values.
# Local development works without `.env` using test defaults in settings.py.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- Database (optional — defaults to SQLite) ---
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=marvin

# --- Branding ---
# What a fork changes to make this its own. All optional.
# BRAND_APP_NAME=Marvin
# BRAND_ORG_NAME=Geeko Foundation
# BRAND_TAGLINE=Travel Support Program
# Any daisyUI theme name, see https://daisyui.com/docs/themes/
# BRAND_THEME_LIGHT=corporate
# BRAND_THEME_DARK=business

# --- Web Push (django-webpush) ---
WEBPUSH_APP_BASE_URL=https://yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# --- Wise API ---
WISE_API_TOKEN=
WISE_API_PROFILE_ID=
WISE_API_SANDBOX=false
WISE_SOURCE_CURRENCY=GBP

# --- Email (optional) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
