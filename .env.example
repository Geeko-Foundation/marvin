# Copy this file to `.env` and set production values.
# Local development works without `.env` using test defaults in settings.py.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Only needed if the site is served over plain http or on a non standard port.
# Otherwise https:// of each ALLOWED_HOSTS entry is trusted automatically.
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Database (optional, defaults to SQLite) ---
# For PostgreSQL, install the driver with `uv sync --extra postgres` and set:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=marvin
# DATABASE_USER=marvin
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# Seconds to keep a connection open. 0 closes it after every request.
# DATABASE_CONN_MAX_AGE=60

# --- Branding ---
# What a fork changes to make this its own. All optional.
# BRAND_APP_NAME=Marvin
# BRAND_ORG_NAME=Geeko Foundation
# BRAND_TAGLINE=Travel Support Program
# Any daisyUI theme name, see https://daisyui.com/docs/themes/
# BRAND_THEME_LIGHT=corporate
# BRAND_THEME_DARK=business

# --- Web Push (django-webpush) ---
WEBPUSH_APP_BASE_URL=https://yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# --- Wise API ---
WISE_API_TOKEN=
WISE_API_PROFILE_ID=
WISE_API_SANDBOX=false
WISE_SOURCE_CURRENCY=GBP
# Wise's webhook signing key for this environment, from their docs. Needed
# only if you subscribe to transfer state changes. Newlines may be written \n.
# WISE_WEBHOOK_PUBLIC_KEY=

# --- Currencies ---
# Currencies the committee approves in (comma separated).
PAYOUT_CURRENCIES=EUR,USD,GBP
# Optional: today's rate from https://www.exchangerate-api.com (free plan is fine).
# Without it, the European Central Bank's free reference rates are used.
EXCHANGE_RATE_API_KEY=

# --- Email ---
# Without EMAIL_BACKEND set, mail is printed to the console, which is what you
# want in development. For real mail, set the SMTP backend and its settings.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=marvin@yourdomain.com

# Base URL used for links inside notification emails.
SITE_BASE_URL=https://yourdomain.com
