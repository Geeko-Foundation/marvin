# Copy this file to `.env` and set production values.
# Local development works without `.env` using test defaults in settings.py.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- Database (optional — defaults to SQLite) ---
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=marvin

# --- Web Push (django-webpush) ---
WEBPUSH_APP_BASE_URL=https://yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# --- Wise API ---
WISE_API_TOKEN=
WISE_API_PROFILE_ID=
WISE_API_SANDBOX=false
WISE_SOURCE_CURRENCY=GBP

# --- Email ---
# Without EMAIL_BACKEND set, mail is printed to the console, which is what you
# want in development. For real mail, set the SMTP backend and its settings.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=marvin@yourdomain.com

# Base URL used for links inside notification emails.
SITE_BASE_URL=https://yourdomain.com
